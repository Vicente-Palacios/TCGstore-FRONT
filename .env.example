# Copia este archivo como .env.local y completa los valores (.env.local NO se sube a git).
# En Vercel: Settings > Environment Variables, con estos mismos nombres.

# https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# Client ID del App client (tipo SPA)
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# URL del API Gateway, sin "/" al final
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
